{
  "name": "overclick",
  "version": "0.1.12",
  "description": "Run the complete OverClick card workflow from Kimi Code.",
  "keywords": ["overclick", "task-board", "mcp"],
  "author": {
    "name": "OverClick"
  },
  "license": "MIT",
  "skills": ["./skills/overclick"],
  "mcpServers": {
    "overclick": {
      "type": "http",
      "url": "${OVERCLICK_URL}",
      "headers": {
        "Authorization": "Bearer ${OVERCLICK_TOKEN}"
      }
    }
  },
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "*",
      "command": "./hooks/session-start.sh",
      "timeout": 15
    },
    {
      "event": "PostToolUse",
      "matcher": "task_deliver|mcp__.*__task_deliver",
      "command": "./hooks/post-deliver.sh",
      "timeout": 30
    },
    {
      "event": "Stop",
      "matcher": "*",
      "command": "./hooks/stop-guard.sh",
      "timeout": 15
    },
    {
      "event": "PreToolUse",
      "matcher": "task_create|mcp__.*__task_create",
      "command": "./hooks/pre-create.sh",
      "timeout": 15
    }
  ],
  "commands": "./commands"
}
